# Copy to `.env` and fill in. `.env` is gitignored — never commit real credentials.

# Supabase Postgres connection string.
# See docs/BACKEND_SPEC.md §4.5 for the pooler-port caveat (6543 vs 5432).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# OpenAI API key. If unset, the backend uses a deterministic fallback (no crash).
OPENAI_API_KEY=

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
