# n8n webhook: validates input, queries PostgreSQL, calculates skill gap,
# builds AI context, calls OpenAI/Claude, and returns structured JSON.
# Leave unset to use local demo data.
VITE_N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/career-analysis

# REST endpoint backed by the SQL aggregation views over PostgreSQL
# (jobs, skills, companies, roles). Leave unset to use local demo data.
VITE_MARKET_INSIGHTS_URL=https://your-api.example.com/market-insights
