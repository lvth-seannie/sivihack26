# Django
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Neon Postgres - either DATABASE_URL (as copied from the Neon dashboard) ...
DATABASE_URL=

# ... or the individual pieces, used only if DATABASE_URL is empty
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require

# Backblaze B2 (S3-compatible) - file storage, e.g. tender document cache
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT_URL=
B2_REGION_NAME=

# Google AI Studio (Gemini) - used only by extract_tender_data, via ai_client/
GEMINI_API_KEY=
