# Django
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Neon Postgres - either DATABASE_URL (as copied from the Neon dashboard) ...
DATABASE_URL=

# ... or the individual pieces, used only if DATABASE_URL is empty
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require

# Backblaze B2 (S3-compatible) - PDF cache only, not queried at request time
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
